{
  "$schema": "https://opencode.ai/config.json",
  "model": "Frontier",
  "instructions": ["AGENTS.md"],
  "permissions": {
    "default_policy": "allow",
    "rules": {
      "*": "allow"
    }
  },
  "auto_approve": true,
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://9router.home.rfamily.dev/v1",
        "apiKey": "{env:NINE_ROUTER_API_KEY}"
      },
      "models": {
        "cc/claude-fable-5-1": {
          "name": "Claude Fable 5.1",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "cc/claude-opus-5": {
          "name": "Claude Opus 5",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "cx/gpt-6-astra": {
          "name": "Codex GPT 6 Astra",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "cx/gpt-5.6-sol": {
          "name": "Codex GPT 5.6 Sol",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "Frontier": {
          "name": "Frontier",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "Frontier-Lite": {
          "name": "Frontier-Lite",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "Lite": {
          "name": "Lite",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_API_TOKEN}"
      }
    },
    "stripe": {
      "type": "remote",
      "url": "https://mcp.stripe.com"
    },
    "xero": {
      "type": "local",
      "command": ["npx", "-y", "@xeroapi/xero-mcp-server@latest"],
      "environment": {
        "XERO_CLIENT_ID": "${XERO_CLIENT_ID}",
        "XERO_CLIENT_SECRET": "${XERO_CLIENT_SECRET}"
      }
    },
    "servers": {
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com"
      },
      "railway": {
        "type": "remote",
        "url": "https://mcp.railway.com"
      },
      "github": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-github"]
      },
      "stripe": {
        "type": "remote",
        "url": "https://mcp.stripe.com"
      },
      "xero": {
        "type": "local",
        "command": ["npx", "-y", "@xeroapi/xero-mcp-server@latest"],
        "environment": {
          "XERO_CLIENT_ID": "{env:XERO_CLIENT_ID}",
          "XERO_CLIENT_SECRET": "{env:XERO_CLIENT_SECRET}"
        }
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      }
    }
  },
  "plugins": ["@prevalentware/opencode-goal-plugin"],
  "agents": {
    "general": {
      "model": "9router/Frontier-Lite#high",
      "mode": "subagent"
    },
    "explore": {
      "model": "9router/Frontier-Lite#high",
      "mode": "subagent"
    },
    "implementor": {
      "model": "9router/Frontier-Lite#high",
      "mode": "subagent"
    },
    "researcher": {
      "model": "9router/Frontier-Lite#high",
      "mode": "subagent"
    }
  }
}
