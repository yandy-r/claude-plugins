{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "plugins": [
    "@prevalentware/opencode-goal-plugin"
  ],
  "agents": {
    "general": { "model": "gpt-5.6-sol" },
    "explore": { "model": "gpt-5.6-sol" },

    "architect": { "model": "gpt-6-astra" },
    "code-architect": { "model": "gpt-6-astra" },
    "root-cause-analyzer": { "model": "gpt-6-astra" },
    "db-modifier": { "model": "gpt-6-astra" },
    "go-expert-architect": { "model": "gpt-6-astra" },
    "rust-expert-architect": { "model": "gpt-6-astra" },

    "planner": { "model": "gpt-5.6-sol" },
    "test-strategy-planner": { "model": "gpt-5.6-sol" },
    "python-expert-architect": { "model": "gpt-5.6-sol" },
    "typescript-expert-architect": { "model": "gpt-5.6-sol" },
    "code-reviewer": { "model": "gpt-5.6-sol" },
    "implementor": { "model": "gpt-5.6-sol" },
    "research-specialist": { "model": "gpt-5.6-sol" },
    "cloudflare-developer": { "model": "gpt-5.6-sol" },
    "nodejs-backend-developer": { "model": "gpt-5.6-sol" },
    "python-developer": { "model": "gpt-5.6-sol" },
    "typescript-developer": { "model": "gpt-5.6-sol" },
    "terraform-developer": { "model": "gpt-5.6-sol" },
    "sql-database-developer": { "model": "gpt-5.6-sol" },
    "frontend-ui-developer": { "model": "gpt-5.6-sol" },
    "go-api-architect": { "model": "gpt-5.6-sol" },
    "nodejs-backend-architect": { "model": "gpt-5.6-sol" },
    "cloudflare-architect": { "model": "gpt-5.6-sol" },
    "terraform-architect": { "model": "gpt-5.6-sol" },
    "turso-database-architect": { "model": "gpt-5.6-sol" },
    "reverse-proxy-architect": { "model": "gpt-5.6-sol" },
    "systems-engineering-expert": { "model": "gpt-5.6-sol" },
    "nextjs-ux-ui-expert": { "model": "gpt-5.6-sol" },
    "ansible-automation-expert": { "model": "gpt-5.6-sol" },
    "rust-reviewer": { "model": "gpt-5.6-sol" },
    "rust-build-resolver": { "model": "gpt-5.6-sol" },
    "review-fixer": { "model": "gpt-5.6-sol" },
    "pr-comment-fixer": { "model": "gpt-5.6-sol" },
    "release-fix-applier": { "model": "gpt-5.6-sol" },
    "code-researcher": { "model": "gpt-5.6-sol" },
    "feature-researcher": { "model": "gpt-5.6-sol" },
    "prp-researcher": { "model": "gpt-5.6-sol" },
    "practices-researcher": { "model": "gpt-5.6-sol" },
    "codebase-advisor": { "model": "gpt-5.6-sol" },
    "code-explorer": { "model": "gpt-5.6-sol" },
    "architecture-analyst": { "model": "gpt-5.6-sol" },
    "code-simplifier": { "model": "gpt-5.6-sol" },
    "git-cleanup": { "model": "gpt-5.6-sol" },
    "releaser": { "model": "gpt-5.6-sol" },

    "docs-git-committer": { "model": "gpt-5.6-terra" },
    "code-finder": { "model": "gpt-5.6-terra" },
    "api-documenter": { "model": "gpt-5.6-terra" },
    "code-documenter": { "model": "gpt-5.6-terra" },
    "documentation-writer": { "model": "gpt-5.6-terra" },
    "feature-writer": { "model": "gpt-5.6-terra" },
    "readme-generator": { "model": "gpt-5.6-terra" },
    "library-docs-writer": { "model": "gpt-5.6-terra" },
    "api-docs-expert": { "model": "gpt-5.6-terra" },
    "project-file-cleaner": { "model": "gpt-5.6-terra" }
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "settings": {
            "reasoningEffort": "high",
            "textVerbosity": "medium"
          },
          "variants": [
            {
              "id": "subagent",
              "settings": {
                "reasoningEffort": "high",
                "textVerbosity": "low"
              }
            }
          ]
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_API_TOKEN}"
        }
      },
      "stripe": {
        "type": "remote",
        "url": "https://mcp.stripe.com"
      },
      "xero": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@xeroapi/xero-mcp-server@latest"
        ],
        "environment": {
          "XERO_CLIENT_ID": "{env:XERO_CLIENT_ID}",
          "XERO_CLIENT_SECRET": "{env:XERO_CLIENT_SECRET}"
        }
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com"
      },
      "railway": {
        "type": "remote",
        "url": "https://mcp.railway.com"
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ]
      }
    }
  }
}
